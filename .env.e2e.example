# ─────────────────────────────────────────────────────────────────────────────
# E2E ISOLATED ENVIRONMENT — TEMPLATE. Copy to `.env.e2e` (gitignored):
#   cp .env.e2e.example .env.e2e
#
# This file is NEVER reused for local dev or production. It defines a fully
# isolated Postgres, Redis, secrets, and origins so the Playwright suite can
# never touch real data. All values below are throwaway test-local credentials
# for disposable `localhost`-bound containers — safe to commit as a template.
#
# It is consumed two ways:
#   1. By docker compose for the `e2e` profile:
#        docker compose --env-file .env.e2e --profile e2e up --build
#   2. By apps/web/e2e global setup/teardown (via dotenv) for the host-side
#      seed + assertion clients (E2E_DATABASE_URL / E2E_REDIS_URL).
# ─────────────────────────────────────────────────────────────────────────────

# ── Proxy (nginx) ───────────────────────────────────────────────────────────
NGINX_SERVER_NAME=localhost
NGINX_SSL_CERT_FILENAME=localhost.crt
NGINX_SSL_KEY_FILENAME=localhost.key
NGINX_TRUSTED_PROXIES=127.0.0.0/8
NGINX_REAL_IP_HEADER=X-Forwarded-For
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443

# ── Host ports for the seed/assertion clients (host side only) ────────────────
E2E_POSTGRES_PORT=5434
E2E_REDIS_PORT=6381

# ── Postgres (isolated) ───────────────────────────────────────────────────────
POSTGRES_USER=e2e_user
POSTGRES_PASSWORD=e2e_password
POSTGRES_DB=e2e_db
POSTGRES_PORT=5434

# ── Redis (isolated) ─────────────────────────────────────────────────────────
REDIS_PASSWORD=e2e_redis_password
REDIS_PORT=6381

# ── API ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3001
# Throwaway test secret (≥32 chars). Never reuse a real secret here.
BETTER_AUTH_SECRET=e2e-secret-minimum-32-characters-long-1234567890abcd
BETTER_AUTH_URL=https://localhost:8443
NEXT_PUBLIC_APP_URL=https://localhost:8443
TRUSTED_ORIGINS=https://localhost:8443
APP_NAME=E2E Test
EMAIL_FROM=test@example.com
EMAIL_VERIFICATION=relaxed
RESEND_API_KEY=
DEV_EMAIL_OVERRIDE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generous but finite limits; rate-limit tests tighten windows where needed.
RATE_LIMIT_WINDOW=5
RATE_LIMIT_MAX=1000

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api
NEXT_ALLOWED_DEV_ORIGINS=https://localhost:8443
INTERNAL_API_URL=http://api-e2e:3001

# ── Observability (e2e) ─────────────────────────────────────────────────────
# No Alloy/Pyroscope in the e2e profile: OTel SDKs are disabled (fail-open),
# so e2e telemetry never retries against missing collectors. Faro RUM still
# flows through nginx /collect only when the observability overlay is added.
OTEL_SDK_DISABLED=true
NEXT_PUBLIC_FARO_COLLECTOR_URL=https://localhost:8443/collect
NEXT_PUBLIC_FARO_APP_NAME=web
NEXT_PUBLIC_FARO_APP_VERSION=e2e
NEXT_PUBLIC_FARO_ENVIRONMENT=test

# ── Shared observability keys (compose interpolates every service, including
# prod/overlay ones, so they must exist even though e2e never starts them) ──
GIT_SHA=e2e
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_SERVICE_NAME_API=api
OTEL_SERVICE_NAME_WEB=web
OTEL_SERVICE_NAMESPACE=turbo-template
OTEL_LOG_LEVEL=info
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
PYROSCOPE_APPLICATION_NAME=api
FARO_CORS_ORIGINS=*
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_HTTP_PORT=3002
GRAFANA_PORT=3002
PROMETHEUS_PORT=9091

# ── Seed admin (used by apps/web/e2e/scripts/seed.ts) ────────────────────────
SEED_ADMIN_EMAIL=superadmin@test.local
SEED_ADMIN_PASSWORD=e2e-SuperAdmin-Pass-123
SEED_ADMIN_NAME=E2E Super Admin

# Allow the E2E seed to create all four accounts in one burst (Better Auth
# sign-up is otherwise capped at 3/60s).
RATE_LIMIT_SIGNUP_MAX=100

# ── In-container connection strings (docker network) ─────────────────────────
DATABASE_URL=postgresql://e2e_user:e2e_password@postgres-e2e:5432/e2e_db?schema=public
REDIS_URL=redis://:e2e_redis_password@redis-e2e:6379

# ── Host-side connection strings (seed/assertion clients on the runner) ───────
E2E_DATABASE_URL=postgresql://e2e_user:e2e_password@localhost:5434/e2e_db?schema=public
E2E_REDIS_URL=redis://:e2e_redis_password@localhost:6381

# ── Dev-mode container tuning (inherited by api-e2e / web-e2e) ────────────────
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=100
WATCHPACK_POLLING=true
TSC_WATCHFILE=UseDynamicPolling

# ── pgAdmin (not part of the e2e profile, but compose interpolates it) ─────────
PGADMIN_EMAIL=pgadmin@test.local
PGADMIN_PASSWORD=e2e-pgadmin-pass-123

# Snake-oil localhost cert: relax TLS verification for the host seed/assert client.
NODE_TLS_REJECT_UNAUTHORIZED=0
