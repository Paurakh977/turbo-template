# ─────────────────────────────────────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH for BOTH docker and local runs.
#   • Docker Compose substitutes ${VAR} from this file into containers.
#   • Local apps load this file via dotenv (see apps/api/src/load-env.ts,
#     packages/auth/src/load-env.ts, packages/database, apps/web/next.config.js).
# Container env injected by Compose always wins over this file.
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# API (read by NestJS directly: HOST / PORT)
HOST=0.0.0.0
PORT=3001

# Web (container binding only; local `pnpm dev` runs on 3000 because
# apps/web/next.config.js drops the root PORT=3001 unless Compose injected it)
WEB_HOST=0.0.0.0
WEB_PORT=3000

# PostgreSQL
POSTGRES_USER=myapp
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=myapp_db
POSTGRES_PORT=5432
# OPTIONAL — pg pool tuning read by packages/database (defaults shown).
# Injected into the api/api-dev containers; empty/unset = code fallbacks
# (10 / 5000 / 30000), so deleting a line is always safe.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Local connection strings (host = localhost).
# Inside containers Compose builds its own URLs using the service hostnames,
# so these never leak into Docker.
DATABASE_URL=postgresql://myapp:supersecretpassword@localhost:5432/myapp_db?schema=public
REDIS_URL=redis://:redis_password@localhost:6379

# pgAdmin (prod monitoring UI). REQUIRED when the `prod` profile starts
# pgAdmin. The port is bound to 127.0.0.1 only — access via SSH tunnel:
#   ssh -L 5050:127.0.0.1:5050 <host>
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# App
APP_NAME=MyApp

# Browser-to-app routing
# Keep this as /api in both dev and prod when requests always go through nginx.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=https://localhost

# Next.js dev server origin allow-list
# Required because the browser reaches the dev server through the HTTPS nginx proxy.
NEXT_ALLOWED_DEV_ORIGINS=https://localhost

# ---------------------------------------------------------------------------
# Architecture B (secret-free web tier): DATABASE_URL, BETTER_AUTH_SECRET and
# PG* are consumed by the API tier ONLY. The web container intentionally does
# NOT receive them - do not re-add. See docs/architecture-b-migration.md.
# ---------------------------------------------------------------------------

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-at-least-32-chars-long
BETTER_AUTH_URL=https://localhost
TRUSTED_ORIGINS=https://localhost

# OAuth / email (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# REQUIRED in production: without it, requireEmailVerification silently turns
# off and accounts sign up unverified. The API refuses to boot in production
# without a key unless you explicitly set EMAIL_VERIFICATION=relaxed.
RESEND_API_KEY=
# EMAIL_VERIFICATION=relaxed
DEV_EMAIL_OVERRIDE=
EMAIL_FROM=MyApp <onboarding@resend.dev>

# Seed script only
SEED_ADMIN_EMAIL=admin@yourapp.com
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Admin

# ── Rate limiting (Better Auth) ──────────────────────────────────────────────
# Global cap per IP per window. Per-endpoint customRules in auth.ts apply
# stricter limits for sensitive operations (sign-in, 2FA, admin mutations).
# Production: lower to 40-60 if behind a CDN/WAF that handles flood protection.
# NOTE: compose passes these as `${VAR:-}` (empty when unset) and
# parseIntEnv() treats empty as "use the code fallback" — RATE_LIMIT_MAX falls
# back to 20, NOT the 100 below. The values here apply because this file
# populates them; deleting a line reverts that knob to its code fallback.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
# Per-IP signup cap (packages/auth falls back to 3 when unset).
RATE_LIMIT_SIGNUP_MAX=3

# ── Throttler (NestJS global guard) ──────────────────────────────────────────
# Production-safe values shown. Raise LIMIT for k6 runs where all VUs share one IP.
# Same empty-means-fallback rule as above (code fallbacks: 60000 / 200).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200

# ── k6 load testing (host-run stacks only) ───────────────────────────────────
# The api/web loaders layer `.env.k6` on top of this file ONLY when
# K6_TESTING=true is in the environment (see apps/api/src/load-env.ts,
# packages/auth/src/load-env.ts, apps/web/next.config.js). Docker Compose
# never reads `.env.k6` — it affects `pnpm dev` / `pnpm turbo start` runs
# (e.g. infra via `local` profile + apps on the host) that k6 targets.
# Copy `.env.k6.example` to `.env.k6`, loosen the limits there, then:
#   PowerShell: $env:K6_TESTING='true'; pnpm dev
#   bash:       K6_TESTING=true pnpm dev
# K6_TESTING=false

# Session / 2FA tuning (all OPTIONAL - injected into the api containers;
# packages/auth falls back to built-in defaults when unset).
# UNITS: SESSION_* and TWO_FACTOR_COOKIE_MAX_AGE / TRUST_DEVICE_MAX_AGE /
# TWO_FACTOR_TOTP_PERIOD are SECONDS. TWO_FACTOR_OTP_PERIOD is MINUTES
# (better-auth multiplies by 60) - default 3 = 3 minutes.
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
SESSION_FRESH_AGE=900
TWO_FACTOR_TOTP_PERIOD=30
TWO_FACTOR_OTP_PERIOD=3
TWO_FACTOR_OTP_ATTEMPTS=5
TWO_FACTOR_BACKUP_AMOUNT=10
TWO_FACTOR_BACKUP_LENGTH=10
TWO_FACTOR_COOKIE_MAX_AGE=600
TRUST_DEVICE_MAX_AGE=2592000

# Dev-only: allow the seed script to call the local API over the self-signed
# nginx cert. HONORED BY EVERY NODE PROCESS loading this file (api, web, seed),
# so keep it commented for any production or prod-like host run.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Host-run web tier (non-Docker). Docker Compose injects INTERNAL_API_URL
# into the web container automatically; when you run `pnpm dev` / the web
# server directly on your machine it must point at a reachable API instead.
INTERNAL_API_URL=http://localhost:3001

# Public nginx proxy ports
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Nginx HTTPS/TLS
NGINX_SERVER_NAME=localhost
NGINX_SSL_CERT_FILENAME=localhost.crt
NGINX_SSL_KEY_FILENAME=localhost.key

# ── Nginx real client IP (rate-limit bucketing) ──────────────────────────────
# nginx keys its rate/connection limits on the connection peer. When nothing
# sits in front of nginx (direct), leave this as 127.0.0.0/8 — it never matches
# a real client, so the true IP is used (no-op). When you put a load balancer or
# CDN (Cloudflare, etc.) in front, set NGINX_TRUSTED_PROXIES to its CIDRs
# (space-separated) so nginx restores the real visitor IP into the buckets.
# For Cloudflare you may also set NGINX_REAL_IP_HEADER=CF-Connecting-IP.
NGINX_TRUSTED_PROXIES=127.0.0.0/8
NGINX_REAL_IP_HEADER=X-Forwarded-For
# Per-IP concurrent-connection cap, injected via NGINX_CONN_LIMIT_PLACEHOLDER in nginx.conf (entrypoint.sh, default 20).
NGINX_CONN_LIMIT=20

# ── cAdvisor resource budget (per-host customizable) ─────────────────────────
# Caps the most privileged container in the stack (see cadvisor service in
# docker-compose.observability.yml) so it degrades alone instead of
# OOM-killing postgres/tempo under load. Plain (non-swarm) compose fields:
# mem takes 512m / 1g / raw bytes, cpus takes 1.0 / 0.5. The compose-file
# defaults match these values, so leaving them unset behaves identically.
CADVISOR_MEM_LIMIT=512m
CADVISOR_MEM_RESERVATION=256m
CADVISOR_CPUS=1.0

# ── Observability & Monitoring ──────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH. Every key below is REQUIRED:
#   • docker-compose.yml / docker-compose.observability.yml reference it with
#     ${VAR:?} (fail-fast, no silent defaults, no hardcoded literals).
#   • apps/api/src/otel.ts + apps/web/src/instrumentation.ts throw at boot
#     when a required key is missing.
# OTEL_SDK_DISABLED=false everywhere except the e2e/test profiles (which set
# it to true — no collectors there, so SDKs stay fail-open no-ops).
# Local dev (outside Docker): otel.ts / instrumentation.ts rewrite
# alloy:4317→localhost:4317 and pyroscope:4040→localhost:4040 when /.dockerenv
# is absent, so keep the docker hostnames here even for host runs.
# Only point OTEL_EXPORTER_OTLP_ENDPOINT elsewhere for a remote collector.
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# Tier identities. Compose maps _API/_WEB → OTEL_SERVICE_NAME per container,
# so api and web never collide. Host runs: otel.ts prefers OTEL_SERVICE_NAME_API,
# instrumentation.ts prefers OTEL_SERVICE_NAME_WEB (both fall back to
# OTEL_SERVICE_NAME, which stays "api" for host-run api compatibility).
OTEL_SERVICE_NAME=api
OTEL_SERVICE_NAME_API=api
OTEL_SERVICE_NAME_WEB=web
OTEL_SERVICE_NAMESPACE=turbo-template
# Single version source: GIT_SHA everywhere. Compose maps GIT_SHA into
# OTEL_SERVICE_VERSION=${GIT_SHA} and NEXT_PUBLIC_FARO_APP_VERSION=${GIT_SHA}
# inside containers; otel.ts / instrumentation.ts accept EITHER key
# (OTEL_SERVICE_VERSION first, GIT_SHA fallback), so host runs work with both
# set here. When cutting a release, bump GIT_SHA (CI does this automatically);
# OTEL_SERVICE_VERSION below is the host-run fallback only.
OTEL_SERVICE_VERSION=dev
GIT_SHA=dev
# Container environment follows the compose profile (production / development /
# test literals in docker-compose.yml, mirroring NODE_ENV). This value is for
# HOST runs only — set to "production" in production .env files.
OTEL_ENVIRONMENT=development
# Consumed by packages/observability logging.ts (pino level).
OTEL_LOG_LEVEL=info
# Web has no profiler by design — api only. Omit in tiers without profiling.
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
PYROSCOPE_APPLICATION_NAME=api
GF_SECURITY_ADMIN_USER=admin
# SECURITY: rotate in prod.
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_HTTP_PORT=3002
GRAFANA_PORT=3002
# Host-mapped Prometheus port (container is always 9090).
PROMETHEUS_PORT=9091

# Faro Browser Real User Monitoring (RUM)
# NEXT_PUBLIC_FARO_* is baked at `next build` time — rebuild web after changing.
# e2e profile uses https://localhost:8443/collect (port shift).
NEXT_PUBLIC_FARO_COLLECTOR_URL=https://localhost/collect
NEXT_PUBLIC_FARO_APP_NAME=web
NEXT_PUBLIC_FARO_APP_VERSION=dev
NEXT_PUBLIC_FARO_ENVIRONMENT=development
# SECURITY: Restrict Faro CORS origins in production (comma-separated domains).
# Default "*" allows any origin — change to your app domain(s) before deploying.
# Wired to Alloy faro.receiver via sys.env+string.split (see observability/alloy/config.alloy).
# Example: FARO_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FARO_CORS_ORIGINS=*

# ── Integration Testing ──────────────────────────────────────────────────────
# Template: .env.test.example → copy to .env.test (gitignored). NEVER reuse
# .env or .env.local for tests.
# Run with (detached + wait — NOT --abort-on-container-exit: migrate-test's
# clean exit 0 would abort the suite before api-test finishes):
#   docker compose --profile test up --build -d
#   docker wait template-turbo-repo-api-test-1  # exit code = suite result
# Or locally: cp .env.test .env && pnpm --filter api test:integration
#
# TEST_POSTGRES_USER=test_user
# TEST_POSTGRES_PASSWORD=test_password
# TEST_POSTGRES_DB=test_db
# (host mappings TEST_POSTGRES_PORT=5433 / TEST_REDIS_PORT=6380 live in
# .env.test.example alongside the active values above)
# TEST_BETTER_AUTH_SECRET=test-secret-minimum-32-characters-long!!
# TEST_APP_NAME=Integration Test
# TEST_EMAIL_FROM=test@example.com
# REDIS_PREFIX=int-test: