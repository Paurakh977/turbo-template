# Shared app container bindings
# These are internal container ports/hosts used by both dev and prod profiles.
API_HOST=0.0.0.0
API_PORT=3001
WEB_HOST=0.0.0.0
WEB_PORT=3000

# PostgreSQL
POSTGRES_USER=myapp
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=myapp_db
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_PASSWORD=redis_password


# Better Auth
BETTER_AUTH_SECRET=your-super-secret-at-least-32-chars-long
BETTER_AUTH_URL=https://localhost
NEXT_PUBLIC_APP_URL=https://localhost
TRUSTED_ORIGINS=
APP_NAME=MyApp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
DEV_EMAIL_OVERRIDE=
EMAIL_FROM=MyApp <onboarding@resend.dev>

# Browser-to-app routing
# Keep this as /api in both dev and prod when requests always go through nginx.
NEXT_PUBLIC_API_URL=/api

# Server-side web-to-API routing inside Docker.
# Compose injects this automatically, so you normally do not set it in `.env`.

# Next.js dev server origin allow-list
# This is required by the Next.js dev server because the browser reaches it
# through the HTTPS nginx proxy. Use the exact external HTTPS origin(s).
# Multiple origins can be comma-separated.
NEXT_ALLOWED_DEV_ORIGINS=https://localhost

# Public nginx proxy ports
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Nginx HTTPS/TLS
NGINX_SERVER_NAME=localhost
NGINX_SSL_CERT_FILENAME=localhost.crt
NGINX_SSL_KEY_FILENAME=localhost.key

SEED_ADMIN_EMAIL=admin@yourapp.com
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Admin