{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/integration/jest-integration.config.cjs --runInBand --forceExit",
    "test:integration:strict": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/integration/jest-integration.strict.config.cjs --runInBand --forceExit",
    "test:integration:oauth": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/integration/jest-integration.oauth.config.cjs --runInBand --forceExit",
    "test:integration:all": "pnpm run test:integration && pnpm run test:integration:strict && pnpm run test:integration:oauth",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:^",
    "@repo/database": "workspace:^",
    "@repo/roles": "workspace:^",
    "@thallesp/nestjs-better-auth": "2.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "catalog:",
    "compression": "^1.8.1",
    "dotenv": "catalog:",
    "helmet": "^8.1.0",
    "ioredis": "catalog:",
    "joi": "^18.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^4.17.25",
    "@types/ioredis": "^5.0.0",
    "@types/joi": "^17.2.3",
    "@types/node": "^22.19.3",
    "@types/nock": "^11.1.0",
    "jose": "^5.9.6",
    "nock": "^13.5.5",
    "otplib": "^12.0.1",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
