# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV TURBO_TELEMETRY_DISABLED=1
ENV NPM_CONFIG_NODE_LINKER=isolated
RUN apk add --no-cache libc6-compat \
  && corepack enable
WORKDIR /repo

FROM base AS pruner
ARG TURBO_VERSION=2.10.10
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune api --docker

FROM base AS installer
WORKDIR /app
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=api-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile

FROM installer AS builder
ARG DATABASE_URL
ARG BETTER_AUTH_SECRET
ARG BETTER_AUTH_URL
ARG TURBO_TEAM
ARG TURBO_TOKEN
ENV NODE_ENV=production
ENV DATABASE_URL=$DATABASE_URL
ENV BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
ENV BETTER_AUTH_URL=$BETTER_AUTH_URL
ENV TURBO_TEAM=$TURBO_TEAM
ENV TURBO_TOKEN=$TURBO_TOKEN
COPY --from=pruner /repo/out/full/ .
RUN pnpm --filter @repo/database db:generate
RUN pnpm turbo run build --filter=api...

FROM builder AS deployer
RUN pnpm deploy --filter=api --prod /prod/api

FROM node:22-alpine AS migrator
WORKDIR /app

RUN corepack enable

COPY apps/migrate/package.json apps/migrate/pnpm-lock.yaml ./
COPY --from=pruner /repo/out/full/packages/database/prisma ./prisma
COPY --from=pruner /repo/out/full/packages/database/prisma.config.ts ./prisma.config.ts
RUN --mount=type=cache,id=migrate-pnpm-store,target=/pnpm/store \
  pnpm install --prod --frozen-lockfile --store-dir /pnpm/store

USER node
CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]

FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache dumb-init wget

ENV NODE_ENV=production

COPY --from=deployer --chown=node:node /prod/api ./

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/" > /dev/null || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main"]
