# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV TURBO_TELEMETRY_DISABLED=1
ENV NPM_CONFIG_NODE_LINKER=isolated
RUN apk add --no-cache libc6-compat \
  && corepack enable
WORKDIR /repo

FROM base AS pruner
ARG TURBO_VERSION=2.10.10
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune api --docker

FROM base AS installer
WORKDIR /app
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=api-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile

FROM installer AS builder
ARG TURBO_TEAM
ARG TURBO_TOKEN
ENV NODE_ENV=production
ENV TURBO_TEAM=$TURBO_TEAM
ENV TURBO_TOKEN=$TURBO_TOKEN
# prisma.config.ts resolves DATABASE_URL via env() at generate time (it never
# opens a connection), so a placeholder keeps REAL credentials out of build
# args and therefore out of build cache/provenance metadata.
ENV DATABASE_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=public
COPY --from=pruner /repo/out/full/ .
RUN pnpm --filter @repo/database db:generate
RUN pnpm turbo run build --filter=api...

# Production dependency tree assembled FRESH from the exact manifests +
# lockfile the build used. Deliberately NOT `pnpm deploy` / `prune`: both
# changed semantics across pnpm 8->11 (peer materialization, injected
# workspaces, module-dir relayout). A plain --prod install is stable,
# reviewable, and ships precisely what the lockfile's production graph says.
FROM base AS prod-deps
WORKDIR /rt
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=api-pnpm-store,target=/pnpm/store \
  pnpm install --prod --frozen-lockfile

# Runtime payload: built outputs of the API and every workspace package it
# links against.
FROM prod-deps AS runtime
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/auth/dist ./packages/auth/dist
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/roles/dist ./packages/roles/dist
COPY --from=builder /app/packages/api/dist ./packages/api/dist
# --prod frozen installs skip workspace link creation; restore the four
# @repo/* links Node needs to resolve the imports above.
RUN mkdir -p /rt/node_modules/@repo \
  && ln -s ../../packages/auth       /rt/node_modules/@repo/auth \
  && ln -s ../../packages/database   /rt/node_modules/@repo/database \
  && ln -s ../../packages/roles      /rt/node_modules/@repo/roles \
  && ln -s ../../packages/api        /rt/node_modules/@repo/api
#
# Dead-weight deletion, each entry tied to its origin chain (boot smoke test
# guards the whole list - it already caught two wrong guesses):
#   prisma CLI chain (peer-suffix of @prisma/client satisfied by
#   packages/database devDeps, dragged through every consumer):
#     prisma, @prisma/studio-core, @prisma/engines, @electric-sql/pglite,
#     effect, elkjs, remeda, mysql2
#   UI/react stack (react peers of better-auth/client chain):
#     react, react-dom, scheduler, @radix-ui, @types/react*, csstype,
#     classnames, @visx, d3-*, delaunator, robust-predicates, internmap
#   typescript: peer-satisfied via database devDeps; never loaded at runtime
# KEEP - @opentelemetry/semantic-conventions: eagerly imported by
# @better-auth/core's instrumentation module at startup (verified by boot
# failure when removed). When real OTel tracing lands, its api+sdk packages
# install under their own store keys alongside this one.
RUN rm -rf \
      /rt/node_modules/.pnpm/prisma@* \
      /rt/node_modules/.pnpm/@prisma+studio-core* \
      /rt/node_modules/.pnpm/@prisma+engines@* \
      /rt/node_modules/.pnpm/@prisma+query-plan-executor* \
      /rt/node_modules/.pnpm/@prisma+streams-local* \
      /rt/node_modules/.pnpm/@electric-sql+pglite* \
      /rt/node_modules/.pnpm/effect@* \
      /rt/node_modules/.pnpm/elkjs* \
      /rt/node_modules/.pnpm/remeda@* \
      /rt/node_modules/.pnpm/mysql2* \
      /rt/node_modules/.pnpm/react@* \
      /rt/node_modules/.pnpm/react-dom@* \
      /rt/node_modules/.pnpm/scheduler@* \
      /rt/node_modules/.pnpm/@radix-ui+* \
      /rt/node_modules/.pnpm/@types+react* \
      /rt/node_modules/.pnpm/csstype* \
      /rt/node_modules/.pnpm/classnames@* \
      /rt/node_modules/.pnpm/@visx+* \
      /rt/node_modules/.pnpm/d3-* \
      /rt/node_modules/.pnpm/delaunator* \
      /rt/node_modules/.pnpm/robust-predicates* \
      /rt/node_modules/.pnpm/internmap* \
      /rt/node_modules/.pnpm/typescript@* \
  && find /rt/node_modules/.pnpm/@prisma+client*/node_modules/@prisma/client/runtime \
      -type f \( -name '*_bg.mysql*' -o -name '*_bg.sqlite*' \
                 -o -name '*_bg.cockroachdb*' -o -name '*_bg.sqlserver*' \) -delete

FROM node:22-alpine AS runner
WORKDIR /rt

RUN apk add --no-cache dumb-init wget

ENV NODE_ENV=production

COPY --from=runtime --chown=node:node /rt ./

WORKDIR /rt/apps/api

# Hardening: no package managers in the running container. (Base layers still
# carry these bytes, so this is security hygiene, not a size optimization.)
RUN rm -rf /opt/yarn* /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn \
           /usr/local/bin/yarnpkg /usr/local/bin/corepack

USER node
EXPOSE 3001

# Liveness only: busybox wget exits non-zero on HTTP 5xx, so a strict
# readiness probe (/api/health/ready) would mark the container unhealthy
# whenever Redis/Postgres are still warming up and block every
# depends_on: service_healthy consumer (web, proxy). Use /api/health/live,
# which always answers 200 once the process is listening. Shell form so the
# runtime PORT env is honored (compose overrides this healthcheck anyway -
# keep both in sync if you change one).
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=12 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3001}/api/health/live" > /dev/null || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main"]
