# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV TURBO_TELEMETRY_DISABLED=1
ENV NPM_CONFIG_NODE_LINKER=isolated
RUN apk add --no-cache libc6-compat \
  && corepack enable
WORKDIR /repo

FROM base AS pruner
ARG TURBO_VERSION=2.10.10
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune api --docker

FROM base AS installer
WORKDIR /app
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=api-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile

FROM installer AS builder
ARG DATABASE_URL
ARG TURBO_TEAM
ARG TURBO_TOKEN
ENV NODE_ENV=production
ENV DATABASE_URL=$DATABASE_URL
ENV TURBO_TEAM=$TURBO_TEAM
ENV TURBO_TOKEN=$TURBO_TOKEN
COPY --from=pruner /repo/out/full/ .
RUN pnpm --filter @repo/database db:generate
RUN pnpm turbo run build --filter=api...

FROM builder AS deployer
RUN pnpm deploy --filter=api --prod /prod/api

# Trim runtime dead weight pulled in via optional peer deps (autoInstallPeers):
#   - typescript: @prisma/client's optional peer, never used at runtime
#   - @prisma/client ships WASM query compilers base64-embedded for ALL
#     providers (mysql/sqlite/cockroachdb/sqlserver); keep postgresql only.
# KEEP (verified by boot smoke test):
#   - kysely — better-auth's entry eagerly loads @better-auth/kysely-adapter
#     even when prismaAdapter() is used
#   - libphonenumber-js — direct dependency of class-validator; removing it
#     makes Nest report "class-validator package is missing"
FROM deployer AS trimmer
RUN rm -rf /prod/api/node_modules/.pnpm/typescript@* /prod/api/node_modules/typescript \
  && find /prod/api/node_modules/.pnpm/@prisma+client*/node_modules/@prisma/client/runtime \
      -type f \( -name '*_bg.mysql*' -o -name '*_bg.sqlite*' \
                 -o -name '*_bg.cockroachdb*' -o -name '*_bg.sqlserver*' \) -delete

FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache dumb-init wget

ENV NODE_ENV=production

COPY --from=trimmer --chown=node:node /prod/api ./

# Hardening: no package managers in the running container. (Base layers still
# carry these bytes, so this is security hygiene, not a size optimization.)
RUN rm -rf /opt/yarn* /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn \
           /usr/local/bin/yarnpkg /usr/local/bin/corepack

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/" > /dev/null || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main"]
