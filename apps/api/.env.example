# ─────────────────────────────────────────────────────────────────────────────
# apps/api — environment reference (DOCUMENTATION ONLY)
#
# The API does NOT load this file. All variables are read from the ROOT .env
# (loaded by apps/api/src/load-env.ts at startup). Docker Compose injects the
# same variables directly into the api container, overriding the root .env.
#
# Every variable marked REQUIRED is validated by apps/api/src/env.ts and the
# Joi schema in apps/api/src/app.module.ts — the API refuses to boot without
# them. Optional variables only enable features when non-empty.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — NestJS bind address/port
HOST=0.0.0.0
PORT=3001

# REQUIRED — PostgreSQL connection (local runs: localhost; container: injected by Compose)
DATABASE_URL=postgresql://myapp:supersecretpassword@localhost:5432/myapp_db?schema=public

# REQUIRED — Redis connection
REDIS_URL=redis://:redis_password@localhost:6379

# REQUIRED — Better Auth
BETTER_AUTH_URL=https://localhost
BETTER_AUTH_SECRET=your-super-secret-at-least-32-chars-long
NEXT_PUBLIC_APP_URL=https://localhost
APP_NAME=MyApp

# OPTIONAL — extra CORS/trusted origins (comma-separated). Empty = disabled.
TRUSTED_ORIGINS=https://localhost

# OPTIONAL — OAuth providers (empty pair = provider disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OPTIONAL — transactional email (empty RESEND_API_KEY = emails logged, not sent)
RESEND_API_KEY=
DEV_EMAIL_OVERRIDE=
EMAIL_FROM=MyApp <onboarding@resend.dev>

# DEV-ONLY — allow the seed script to call the local API over the self-signed
# nginx cert. Never set in production.
NODE_TLS_REJECT_UNAUTHORIZED=0