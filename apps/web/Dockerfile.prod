# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV TURBO_TELEMETRY_DISABLED=1
ENV NEXT_TELEMETRY_DISABLED=1
ENV NPM_CONFIG_NODE_LINKER=isolated
RUN apk add --no-cache libc6-compat \
  && corepack enable
WORKDIR /repo

FROM base AS pruner
ARG TURBO_VERSION=2.10.10
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune web --docker

FROM base AS installer
WORKDIR /app
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=web-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile

FROM installer AS builder
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_ALLOWED_DEV_ORIGINS
ARG NEXT_PUBLIC_FARO_COLLECTOR_URL
ARG NEXT_PUBLIC_FARO_APP_NAME
ARG NEXT_PUBLIC_FARO_APP_VERSION
ARG NEXT_PUBLIC_FARO_ENVIRONMENT
ARG TURBO_TEAM
ARG TURBO_TOKEN
ENV NODE_ENV=production
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_ALLOWED_DEV_ORIGINS=$NEXT_ALLOWED_DEV_ORIGINS
ENV NEXT_PUBLIC_FARO_COLLECTOR_URL=$NEXT_PUBLIC_FARO_COLLECTOR_URL
ENV NEXT_PUBLIC_FARO_APP_NAME=$NEXT_PUBLIC_FARO_APP_NAME
ENV NEXT_PUBLIC_FARO_APP_VERSION=$NEXT_PUBLIC_FARO_APP_VERSION
ENV NEXT_PUBLIC_FARO_ENVIRONMENT=$NEXT_PUBLIC_FARO_ENVIRONMENT
ENV TURBO_TEAM=$TURBO_TEAM
ENV TURBO_TOKEN=$TURBO_TOKEN
# prisma.config.ts resolves DATABASE_URL/DIRECT_URL via env() at generate time
# (it never opens a connection), so a placeholder keeps REAL credentials out of
# build args and therefore out of build cache/provenance metadata. Identical to
# apps/api/Dockerfile.prod.
ENV DATABASE_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=public
ENV DIRECT_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=public
COPY --from=pruner /repo/out/full/ .
# Architecture B still HOLDS: the runner stage below receives no DATABASE_URL and
# no prisma client, so nothing in the shipped image can reach Postgres.
#
# The BUILD stage, however, compiles @repo/database (web -> auth -> database)
# and packages/database/src/seed.ts imports the generated Prisma client. So the
# client must exist HERE. Previously this only worked because a locally
# generated, gitignored `packages/database/src/generated/` leaked into the build
# context through `COPY . .` — an accident that breaks on any clean checkout,
# and which `.dockerignore`'s `**/generated` rule correctly closed off.
# `prisma generate` opens no connection, and this stage is discarded after build,
# so the shipped image is unaffected.
RUN pnpm --filter @repo/database db:generate
RUN pnpm turbo run build --filter=web...

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache dumb-init libc6-compat wget \
  && addgroup -S nextjs -g 1001 \
  && adduser -S nextjs -u 1001 -G nextjs
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 3000

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/web/server.js"]
