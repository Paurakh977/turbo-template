{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_ALLOWED_DEV_ORIGINS",
        "APP_NAME",
        "EMAIL_FROM"
      ],
      "passThroughEnv": ["BETTER_AUTH_URL"]
    }
  }
}
