# ─────────────────────────────────────────────────────────────────────────────
# apps/web — environment reference (DOCUMENTATION ONLY)
#
# The web app does NOT load this file at runtime. All variables are read from
# the ROOT .env (loaded by apps/web/next.config.js). Docker Compose injects the
# same variables directly into the web container, overriding the root .env.
#
# Every variable marked REQUIRED is validated in apps/web/next.config.js and
# apps/web/src/env.ts — the app refuses to build/start without them.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — browser-to-API routing; keep "/api" when behind nginx.
# Use an absolute URL (e.g. https://api.example.com) only when NOT behind nginx.
NEXT_PUBLIC_API_URL=/api

# REQUIRED — public app origin (cookie/redirect domain)
NEXT_PUBLIC_APP_URL=https://localhost

# REQUIRED — Better Auth
BETTER_AUTH_URL=https://localhost
# BETTER_AUTH_SECRET is intentionally NOT set here - Architecture B keeps the signing secret in the API tier only.

# REQUIRED — @repo/auth reads these at IMPORT time (packages/auth/src/auth.ts).
# The web imports `{ auth }` server-side (require-admin.ts, check-permission.ts,
# settings/actions.ts, ...), so they must exist in the web process env even
# though next.config.js does not validate them itself.
APP_NAME=MyApp
EMAIL_FROM=MyApp <onboarding@resend.dev>

# REQUIRED in development — browser origin(s) that may reach the Next.js dev
# server through the HTTPS nginx proxy. Comma-separated. Ignored in production.
NEXT_ALLOWED_DEV_ORIGINS=https://localhost

# REQUIRED in production — server-side web-to-API URL. Injected by Docker
# Compose (http://api:3001) or set manually (http://localhost:3001) for local
# `next start` runs. Ignored in development.
INTERNAL_API_URL=http://localhost:3001

# LOCAL-ONLY — overrides the root .env PORT (3001 = API) so the web dev server
# keeps port 3000. next.config.js removes PORT after loading the root .env, so
# this variable is NOT set in production/Docker.
PORT=3000