# ---------------------------------------------------------------------------
# apps/web - environment reference (DOCUMENTATION ONLY)
#
# The web app does NOT load this file at runtime. All variables are read from
# the ROOT .env (loaded by apps/web/next.config.js). Docker Compose injects
# the same variables directly into the web container, overriding the root .env.
#
# Every variable marked REQUIRED is validated in apps/web/next.config.js
# (NEXT_PUBLIC_API_URL, and NEXT_ALLOWED_DEV_ORIGINS in dev). INTERNAL_API_URL
# is enforced at runtime by the server gateways instead.
# ---------------------------------------------------------------------------

# REQUIRED - browser-to-API routing; keep "/api" when behind nginx.
# Use an absolute URL (e.g. https://api.example.com) only when NOT behind nginx.
NEXT_PUBLIC_API_URL=/api

# REQUIRED - public app origin (cookie/redirect domain)
NEXT_PUBLIC_APP_URL=https://localhost

# Better Auth: the browser client resolves window.location.origin at runtime,
# and the SSR fallback in lib/auth-client.ts uses NEXT_PUBLIC_APP_URL, so web
# needs neither BETTER_AUTH_URL nor BETTER_AUTH_SECRET under Architecture B -
# the signing secret lives in the API tier only.

# APP_NAME / EMAIL_FROM are NOT used by web either: every auth operation is
# performed by the API tier via cookie-forwarded HTTP calls
# (lib/server/auth-http.ts + lib/server/internal-api.ts). Web imports of
# @repo/auth are type-only or pure subpaths (/roles, /permissions) and never
# evaluate packages/auth/src/env.ts.

# REQUIRED in development - browser origin(s) that may reach the Next.js dev
# server through the HTTPS nginx proxy. Comma-separated. Ignored in production.
NEXT_ALLOWED_DEV_ORIGINS=https://localhost

# REQUIRED in production - server-side web-to-API URL. Injected by Docker
# Compose (http://api:3001) or set manually (http://localhost:3001) for local
# `next start` runs. Ignored in development.
INTERNAL_API_URL=http://localhost:3001

# LOCAL-ONLY - overrides the root .env PORT (3001 = API) so the web dev server
# keeps port 3000. next.config.js removes PORT after loading the root .env, so
# this variable is NOT set in production/Docker.
PORT=3000
