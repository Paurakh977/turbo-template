# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATION TEST ENVIRONMENT — TEMPLATE. Copy to `.env.test` (gitignored):
#   cp .env.test.example .env.test
#
# Consumed two ways (keep both working):
#   1. Docker: `docker compose --profile test up --build --abort-on-container-exit`
#      (compose uses inline TEST_* defaults; this file is NOT read by compose —
#      TEST_POSTGRES_PORT/REDIS_PORT below document the host mappings 5433/6380).
#   2. Local: `cp .env.test.example .env.test && cp .env.test .env`
#      then `pnpm --filter api test:integration` (apps read DATABASE_URL /
#      REDIS_URL below against LOCAL postgres/redis on 5432/6379).
# NEVER reuse .env or .env.local for tests — this file is fully isolated.
# ─────────────────────────────────────────────────────────────────────────────

# ── API (NestJS reads HOST/PORT directly) ──
HOST=127.0.0.1
PORT=3001

# ── PostgreSQL (test instance) ──
TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=test_password
TEST_POSTGRES_DB=test_db
# Host mapping for the docker test profile (postgres-test:5432 inside).
# TEST_POSTGRES_PORT=5433
# Local-run connection string (local postgres on 5432). The docker test
# profile constructs its own URL from TEST_* above and never reads this.
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_db?schema=public

# ── Redis (test instance, no password, key prefix for isolation) ──
# Host mapping for the docker test profile (redis-test:6379 inside).
# TEST_REDIS_PORT=6380
# Local-run connection string (local redis on 6379).
REDIS_URL=redis://localhost:6379
# Honored by the integration helpers AND the docker api-test service
# (compose interpolates ${REDIS_PREFIX:-int-test:}).
REDIS_PREFIX=int-test:

# ── Better Auth ──
BETTER_AUTH_SECRET=test-secret-minimum-32-characters-long!!
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Integration Test

# ── Trust ──
TRUSTED_ORIGINS=http://localhost:3000

# ── Email (disabled — logged to console, never sent) ──
EMAIL_FROM=test@example.com
EMAIL_VERIFICATION=relaxed
RESEND_API_KEY=
DEV_EMAIL_OVERRIDE=

# ── OAuth (disabled) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Rate limiting (generous for tests) ──
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=1000
# Relaxed signup cap so suites creating several users per window don't
# 429-flake (matches the e2e profile rationale).
RATE_LIMIT_SIGNUP_MAX=100

# ── Observability (disabled — no collectors in the test profile) ──
# The OTel SDKs stay fail-open no-ops. Without this, AppModule's Joi schema
# requires the full OTel set and the test runner refuses to boot — same flag
# the docker `api-test` service injects.
OTEL_SDK_DISABLED=true

# ── Disable TLS verification for local test certs ──
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── NEVER SET here ──
# OAUTH_TEST_PROVIDER=1 is injected programmatically by the OAuth setup
# (apps/api/test/integration/setup.oauth.js) to enable the dummy provider.
# Setting it in this file would leak the dummy provider into every suite.
