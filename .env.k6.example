# ─────────────────────────────────────────────────────────────────────────────
# k6 LOAD-TEST OVERLAY — TEMPLATE. Copy to `.env.k6` (gitignored):
#   cp .env.k6.example .env.k6
#
# HOW IT WORKS: apps/api/src/load-env.ts, packages/auth/src/load-env.ts and
# apps/web/next.config.js load the ROOT .env first, then layer `.env.k6` ON
# TOP — but ONLY when K6_TESTING=true is in the environment. Docker Compose
# never reads this file.
#
# WHEN TO USE IT: k6 targets a stack where the apps run ON THE HOST
# (e.g. infra via `docker compose --profile local up` + `pnpm dev` /
# `pnpm turbo start` on your machine). All k6 VUs share a handful of IPs, so
# production rate limits would 429 the suite itself — this overlay loosens
# exactly those knobs and nothing else.
#
#   1. cp .env.k6.example .env.k6   (then copy your secrets from .env if the
#      overlay needs them — the template below keeps only the deltas)
#   2. PowerShell: $env:K6_TESTING='true'; pnpm dev
#      bash:       K6_TESTING=true pnpm dev
#   3. pnpm k6:load   (targets https://localhost by default)
# ─────────────────────────────────────────────────────────────────────────────

K6_TESTING=true

# Flood gates opened for shared-IP load generators (production values in
# .env.example are 100 / 200 — restore them for any non-k6 run).
RATE_LIMIT_MAX=10000
THROTTLE_LIMIT=10000
