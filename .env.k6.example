# ─────────────────────────────────────────────────────────────────────────────
# k6 LOAD-TEST OVERLAY — TEMPLATE. Copy to `.env.k6` (gitignored):
#   cp .env.k6.example .env.k6
#
# TWO ways to use it (pick one):
#
#   A. Host-run apps (apps on your machine, infra in Docker):
#        docker compose --profile local up -d
#        PowerShell: $env:K6_TESTING='true'; pnpm dev
#        bash:       K6_TESTING=true pnpm dev
#      apps/api/src/load-env.ts, packages/auth/src/load-env.ts and
#      apps/web/next.config.js load the ROOT .env first, then layer `.env.k6`
#      ON TOP — but ONLY when K6_TESTING=true is in the environment.
#
#   B. Container stack (everything in Docker, k6 from your host):
#        docker compose --env-file .env.k6 -f docker-compose.yml \
#          -f docker-compose.observability.yml --profile prod up -d
#      Compose reads ONLY this file (the root .env is ignored), so every key
#      the prod profile requires must exist here (OTEL_*, GIT_SHA, GF_*,
#      PROMETHEUS_PORT, ...). DATABASE_URL / REDIS_URL / INTERNAL_API_URL
#      below are @localhost values for mode A — Compose ignores them for
#      containers (it builds @postgres / @redis / http://api URLs inline).
#
#   Then:  pnpm k6:load   (targets https://localhost by default)
#
# WHAT IT LOOSENS (and why): all k6 VUs share a handful of IPs, so production
# limits would 429 the suite itself at the edge before the backend is stressed.
#   Layer 1 (Nginx per-IP zones) → NGINX_*_RATE/BURST below (env-tunable via
#     placeholders in nginx/nginx.conf, validated by nginx/entrypoint.sh).
#     There is deliberately NO bypass header: any client-controlled bypass
#     maps to an empty limit_req key, i.e. unlimited (see nginx.conf). k6 runs
#     against real limits; thresholds treat 429 as expected, only 5xx fails.
#   Layer 2 (Better Auth)        → RATE_LIMIT_MAX below
#   Layer 3 (NestJS throttler)   → THROTTLE_LIMIT below
#   Layer 4 (PG pool)            → DATABASE_POOL_MAX below
# ─────────────────────────────────────────────────────────────────────────────

K6_TESTING=true

# Load-generator accounts (required by k6 helpers; never commit real mailboxes).
SEED_ADMIN_EMAIL=admin@yourapp.com
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Admin
USER_EMAIL=user@yourapp.com
USER_PASSWORD=UserPassword123!

# Optional suite overrides (defaults live in k6/suites/*.js).
# LOAD_QUICK=true
# SOAK_DURATION=30m

# Flood gates opened for shared-IP load generators (production values in .env.example).
# 2M/60s ≈ effectively unlimited for load testing. At 1k RPS for 220s = 220k requests
# total; old 50k limit was hit after ~50 seconds, causing 58% of checks to 429.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=2000000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=2000000

# Nginx per-IP zones sized for 1500 maxVUs from one IP (each HTTP/2 VU = 1 TCP connection).
# Must exceed maxVUs (1500) + keepalive pool overhead. Production values in
# .env.example are 300r/m auth / 10r/s api / 30r/s general + bursts 10/20/50.
NGINX_CONN_LIMIT=2000
NGINX_AUTH_RATE=20000r/m
NGINX_AUTH_BURST=2000
NGINX_API_RATE=2000r/s
NGINX_API_BURST=2000
NGINX_GENERAL_RATE=2000r/s
NGINX_GENERAL_BURST=2000

# Cluster matrix: workers to test, one value at a time (recreate api only:
# `docker compose --env-file .env.k6 ... up -d api` — no rebuild needed).
# Budget per-worker pools: workers × DATABASE_POOL_MAX ≤ PGBOUNCER_MAX_CLIENT_CONN.
# Matrix runbook: API_WORKERS=1 (baseline) → 2 → 4 → 8, `pnpm k6:capacity` each.
# API_WORKERS=2
# PG & PgBouncer pools for load testing (production values in .env.example are
# 10 / 25). Evidence from 1k-RPS runs: 50/50/20/15 beat 100/70/30/10 (IO-bound,
# not conn-bound) — grow these only with benchmark proof. Peak server conns =
# DEFAULT + RESERVE must stay below POSTGRES_MAX_CONNECTIONS (200 in k6).
DATABASE_POOL_MAX=50
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=15

# ── PostgreSQL SERVER tuning for k6 runs ─────────────────────────
# Same POSTGRES_* contract as .env.example, values sized for sustained write
# bursts (k6 POSTs ~25% of traffic) on a 16-core bench host. Applied via the
# postgres `command:` block in docker-compose.yml; needs a container recreate
# to take effect. Units: memory kB/MB/GB, times ms/s/min/h/d.
# shared_buffers: 768MB (prod 512MB) — larger buffer cache for the hot working
# set; OS page cache covers the rest.
POSTGRES_SHARED_BUFFERS=768MB
# effective_cache_size: 4GB (same as prod) — planner hint only, no allocation.
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
# max_connections: 200 (same as prod) — headroom over PgBouncer peak
# (50 + 15 = 65) for exporter/migrate/direct.
POSTGRES_MAX_CONNECTIONS=200
# checkpoint_timeout: 15min + completion_target 0.9 (same as prod) — spreads
# checkpoint IO; stock 5min/1GB produced a 270s checkpoint write stall at 1k RPS.
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
# max_wal_size: 4GB (prod 2GB) + min_wal_size 1GB (prod 512MB) — fewer
# checkpoints under the k6 write burst; extra recovery time is irrelevant here.
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_MIN_WAL_SIZE=1GB
# wal_buffers: 16MB (same as prod) — avoids extra WAL page writes in bursts.
POSTGRES_WAL_BUFFERS=16MB
# work_mem: 16MB (prod 8MB) — sorts are tiny indexed LIMIT queries; headroom
# for hundreds of concurrent backends without RAM risk.
POSTGRES_WORK_MEM=16MB
# maintenance_work_mem: 256MB (prod 128MB) — faster autovacuum after bulk k6
# inserts; maintenance-only, not per-query.
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# ── Required keys when used as `docker compose --env-file .env.k6` ──────────
# (copy these from your .env; compose fail-fasts on any missing key)
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# OTEL_SERVICE_NAME=api
# OTEL_SERVICE_NAME_API=api
# OTEL_SERVICE_NAME_WEB=web
# OTEL_SERVICE_NAMESPACE=turbo-template
# OTEL_SERVICE_VERSION=dev
# GIT_SHA=dev
# OTEL_ENVIRONMENT=development
# OTEL_LOG_LEVEL=info
# PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
# PYROSCOPE_APPLICATION_NAME=api
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin
# GF_SERVER_HTTP_PORT=3002
# GRAFANA_PORT=3002
# PROMETHEUS_PORT=9091
# FARO_CORS_ORIGINS=*
# (plus the usual POSTGRES_*, REDIS_*, BETTER_AUTH_*, APP/EMAIL, PROXY_*,
# NGINX_* TLS, SEED_ADMIN_* keys — see .env.example for the full contract)
