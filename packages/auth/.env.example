# ─────────────────────────────────────────────────────────────────────────────
# packages/auth — environment reference (DOCUMENTATION ONLY)
#
# The auth package does NOT load this file. It reads process.env at import
# time (packages/auth/src/auth.ts), which is populated by the ROOT .env
# (loaded by the consuming app: api/web) or injected by Docker Compose.
#
# Variables marked REQUIRED throw at import time if missing. Optional
# variables only enable features when non-empty.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED
BETTER_AUTH_URL=https://localhost
BETTER_AUTH_SECRET=your-super-secret-at-least-32-chars-long
NEXT_PUBLIC_APP_URL=https://localhost
APP_NAME=MyApp
EMAIL_FROM=MyApp <onboarding@resend.dev>

# OPTIONAL — Redis secondary storage / rate limiting (empty = in-memory)
REDIS_URL=redis://:redis_password@localhost:6379

# OPTIONAL — extra trusted origins (comma-separated). Empty = disabled.
TRUSTED_ORIGINS=https://localhost

# OPTIONAL — OAuth providers (empty pair = provider disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OPTIONAL — transactional email (empty RESEND_API_KEY = emails logged, not
# sent). REQUIRED in production: without it email-verification enforcement
# silently turns off, so auth refuses to boot unless EMAIL_VERIFICATION=relaxed.
RESEND_API_KEY=
DEV_EMAIL_OVERRIDE=

# OPTIONAL — tunables (empty = library defaults). All SECONDS except
# TWO_FACTOR_OTP_PERIOD, which better-auth interprets as MINUTES.
SESSION_EXPIRES_IN=
SESSION_UPDATE_AGE=
SESSION_FRESH_AGE=
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=
TWO_FACTOR_TOTP_PERIOD=
TWO_FACTOR_OTP_PERIOD=
TWO_FACTOR_OTP_ATTEMPTS=
TWO_FACTOR_BACKUP_AMOUNT=
TWO_FACTOR_BACKUP_LENGTH=
TWO_FACTOR_COOKIE_MAX_AGE=
TRUST_DEVICE_MAX_AGE=