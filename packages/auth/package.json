{
  "name": "@repo/auth",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "./dist/**",
    "./src/**"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "import": "./dist/permissions.js",
      "require": "./dist/permissions.js"
    },
    "./roles": {
      "types": "./src/roles.ts",
      "import": "./dist/roles.js",
      "require": "./dist/roles.js"
    },
    "./password-policy": {
      "types": "./src/password-policy.ts",
      "import": "./dist/password-policy.js",
      "require": "./dist/password-policy.js"
    }
  },
  "scripts": {
    "dev": "pnpm build --watch",
    "build": "tsc -b -v",
    "lint": "eslint \"src/**/*.ts\"",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config ./src/auth.ts --output ../database/prisma/models/betterAuth.prisma --yes && node scripts/post-generate.mjs ../database/prisma/models/betterAuth.prisma"
  },
  "dependencies": {
    "@repo/database": "workspace:^",
    "better-auth": "^1.6.0",
    "ioredis": "^5.8.2",
    "resend": "^6.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.2",
    "typescript": "5.5.4"
  }
}
