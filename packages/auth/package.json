{
  "name": "@repo/auth",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "./dist/**",
    "./src/**"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./permissions": {
      "types": "./src/shared/permissions.ts",
      "import": "./dist/shared/permissions.js",
      "require": "./dist/shared/permissions.js"
    },
    "./roles": {
      "types": "./src/shared/roles.ts",
      "import": "./dist/shared/roles.js",
      "require": "./dist/shared/roles.js"
    },
    "./password-policy": {
      "types": "./src/shared/password-policy.ts",
      "import": "./dist/shared/password-policy.js",
      "require": "./dist/shared/password-policy.js"
    }
  },
  "scripts": {
    "dev": "pnpm build --watch",
    "build": "tsc -b -v",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config ./src/auth.ts --output ../database/prisma/models/betterAuth.prisma --yes && node scripts/post-generate.mjs ../database/prisma/models/betterAuth.prisma && echo \"\" && echo \"NOTE: betterAuth.prisma changed? The DB has NOT been touched.\" && echo \"NEXT: run 'pnpm db:migrate:dev' to capture the drift as a migration,\" && echo \"then 'pnpm db:generate' if the Prisma client needs rebuilding.\""
  },
  "dependencies": {
    "@repo/database": "workspace:^",
    "@repo/observability": "workspace:^",
    "@repo/roles": "workspace:^",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "ioredis": "catalog:",
    "resend": "^6.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/jest-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.0",
    "typescript": "catalog:"
  }
}
