# ─────────────────────────────────────────────────────────────────────────────
# packages/database — environment reference (DOCUMENTATION ONLY)
#
# The database package does NOT load this file. It loads the ROOT .env:
#   • packages/database/prisma.config.ts (prisma generate/migrate/push/studio)
#   • packages/database/src/seed.ts (db:seed)
# Docker Compose injects DATABASE_URL directly into the migrate container.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection (localhost for host runs; Compose overrides
# it with the @postgres hostname inside containers)
DATABASE_URL=postgresql://myapp:supersecretpassword@localhost:5432/myapp_db?schema=public

# REQUIRED — seed script (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@yourapp.com
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Admin

# REQUIRED — seed script: base URL of the running Better Auth API
BETTER_AUTH_URL=https://localhost

# DEV-ONLY — allow the seed to call the local API over the self-signed cert
NODE_TLS_REJECT_UNAUTHORIZED=0