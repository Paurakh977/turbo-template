DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public

# Seed script only — these are read by src/seed.ts
SEED_ADMIN_EMAIL=admin@yourapp.com
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Admin
# Route through nginx proxy (https://localhost). The API container's port
# 3001 is not published to the host. Omit to default to http://localhost:3001.
BETTER_AUTH_URL=https://localhost
# Allow self-signed localhost certs (seed only).
NODE_TLS_REJECT_UNAUTHORIZED=0
