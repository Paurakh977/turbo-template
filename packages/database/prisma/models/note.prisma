model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: single-column [authorId] removed 2026-09 — redundant leftmost
  // prefix of [authorId, createdAt] below. [createdAt] kept for global
  // newest-first listing (admin, no author filter).
  @@index([createdAt])
  // Note listing per author sorted newest-first (covering index)
  @@index([authorId, createdAt(sort: Desc)])
  @@map("note")
}
