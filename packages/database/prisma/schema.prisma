// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Main schema file — contains the generator and datasource blocks.
// Models are split across the files in the `models/` directory.
// Prisma automatically combines all `.prisma` files in the schema directory,
// so models can reference each other across files without imports.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
