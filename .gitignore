# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store*

# Local env files — only the *.example templates are committed (single source
# of truth per consumer: prod, e2e, k6-overlay, integration-test).
.env*
!.env.example
!.env.e2e.example
!.env.k6.example
!.env.test.example

# Testing
.nyc_output
blob-report/
coverage
test-results/
playwright/.cache/
playwright-report/
# Playwright e2e auth state (storageState) — regenerated by the auth setup on
# every e2e run. Contains live session tokens; never commit.
apps/web/e2e/.auth/

# k6 run artifacts — regenerated by every `pnpm k6:*` run (SUMMARY_PATH writes
# here, and `pnpm k6:benchmark` reads from it). Machine-specific benchmark
# output, not source.
k6/results/


# Prisma 7 generated client (regenerate with `pnpm db:generate`)
packages/database/src/generated/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Debug
logs
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build state
*.tsbuildinfo

# Local AI-agent caches. `.agents/` (plural) is the vendored skill set that
# ships with the template; `.agent/` (singular) is per-machine scratch.
.agent/

# Misc
.DS_Store
Thumbs.db

# TLS / certificate material. `nginx/certs/` has its own nested .gitignore,
# but these must be ignored repo-wide so a stray key dropped anywhere else
# can never be committed (and therefore never reach an npm tarball).
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# Registry credentials — never commit, never publish.
.npmrc
.netrc

# npm pack output from `npm pack` / `npm publish` runs.
*.tgz

# >>> npm publish staging (turbo-template) >>>
# Copies made by scripts/stage-template.mjs at prepack time, because npm
# strips .gitignore and the root pnpm-lock.yaml from published tarballs.
# scripts/stage-template.mjs removes this block from the COPY that ships, so
# generated projects receive clean ignore rules.
gitignore
pnpm-lock.template.yaml
apps/api/gitignore
apps/web/gitignore
nginx/certs/gitignore
# <<< npm publish staging (turbo-template) <<<

