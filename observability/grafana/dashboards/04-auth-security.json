          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_total{job=~\"turbo-template/api|api\",route=~\".*/auth/sign-in.*\"}[5m]))",
          "legendFormat": "Sign-in Requests (HTTP)",
          "refId": "C"
        }
      ],
      "title": "Sign-in Rate (Success vs Failure)",
      "type": "timeseries"
    },
