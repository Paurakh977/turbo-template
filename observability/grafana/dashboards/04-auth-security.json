      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(auth_events_total{action=\"sign_in\",status=\"success\"}[5m]))",
          "legendFormat": "Sign-in Success",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
