{
  "$schema": "https://v2-10-10.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_TELEMETRY_DISABLED",
    "NEXT_TELEMETRY_DISABLED",
    "CI"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "HOST",
        "PORT",
        "WEB_HOST",
        "WEB_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TRUSTED_ORIGINS",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_ALLOWED_DEV_ORIGINS",
        "INTERNAL_API_URL",
        "APP_NAME",
        "EMAIL_FROM",
        "RESEND_API_KEY",
        "DEV_EMAIL_OVERRIDE",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD",
        "SEED_ADMIN_NAME",
        "RATE_LIMIT_WINDOW",
        "RATE_LIMIT_MAX",
        "SESSION_EXPIRES_IN",
        "SESSION_UPDATE_AGE",
        "SESSION_FRESH_AGE",
        "TWO_FACTOR_TOTP_PERIOD",
        "TWO_FACTOR_OTP_PERIOD",
        "TWO_FACTOR_OTP_ATTEMPTS",
        "TWO_FACTOR_BACKUP_AMOUNT",
        "TWO_FACTOR_BACKUP_LENGTH",
        "TWO_FACTOR_COOKIE_MAX_AGE",
        "TRUST_DEVICE_MAX_AGE",
        "CHOKIDAR_USEPOLLING",
        "CHOKIDAR_INTERVAL",
        "WATCHPACK_POLLING",
        "TSC_WATCHFILE",
        "OTEL_SDK_DISABLED",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "OTEL_SERVICE_NAME_API",
        "OTEL_SERVICE_NAME_WEB",
        "OTEL_SERVICE_NAMESPACE",
        "OTEL_SERVICE_VERSION",
        "GIT_SHA",
        "OTEL_ENVIRONMENT",
        "OTEL_LOG_LEVEL",
        "PYROSCOPE_SERVER_ADDRESS",
        "PYROSCOPE_APPLICATION_NAME",
        "NEXT_PUBLIC_FARO_COLLECTOR_URL",
        "NEXT_PUBLIC_FARO_APP_NAME",
        "NEXT_PUBLIC_FARO_APP_VERSION",
        "NEXT_PUBLIC_FARO_ENVIRONMENT"
      ]
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "HOST",
        "PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TRUSTED_ORIGINS",
        "NEXT_PUBLIC_APP_URL",
        "INTERNAL_API_URL",
        "APP_NAME",
        "EMAIL_FROM",
        "OTEL_SDK_DISABLED",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "OTEL_SERVICE_NAME_API",
        "OTEL_SERVICE_NAME_WEB",
        "OTEL_SERVICE_NAMESPACE",
        "OTEL_SERVICE_VERSION",
        "GIT_SHA",
        "OTEL_ENVIRONMENT",
        "OTEL_LOG_LEVEL",
        "PYROSCOPE_SERVER_ADDRESS",
        "PYROSCOPE_APPLICATION_NAME",
        "NEXT_PUBLIC_FARO_COLLECTOR_URL",
        "NEXT_PUBLIC_FARO_APP_NAME",
        "NEXT_PUBLIC_FARO_APP_VERSION",
        "NEXT_PUBLIC_FARO_ENVIRONMENT"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_ALLOWED_DEV_ORIGINS",
        "NEXT_PUBLIC_FARO_COLLECTOR_URL",
        "NEXT_PUBLIC_FARO_APP_NAME",
        "NEXT_PUBLIC_FARO_APP_VERSION",
        "NEXT_PUBLIC_FARO_ENVIRONMENT"
      ],
      "passThroughEnv": [
        "INTERNAL_API_URL",
        "OTEL_SDK_DISABLED",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "OTEL_SERVICE_NAME_API",
        "OTEL_SERVICE_NAME_WEB",
        "OTEL_SERVICE_NAMESPACE",
        "OTEL_SERVICE_VERSION",
        "GIT_SHA",
        "OTEL_ENVIRONMENT",
        "OTEL_LOG_LEVEL",
        "PYROSCOPE_SERVER_ADDRESS",
        "PYROSCOPE_APPLICATION_NAME"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "APP_NAME"
      ]
    },
    "test:e2e": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "APP_NAME",
        "TRUSTED_ORIGINS",
        "NEXT_PUBLIC_APP_URL",
        "E2E_DATABASE_URL",
        "E2E_REDIS_URL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD",
        "SEED_ADMIN_NAME",
        "NODE_TLS_REJECT_UNAUTHORIZED",
        "NODE_ENV",
        "CI",
        "PLAYWRIGHT_BASE_URL",
        "RATE_LIMIT_WINDOW",
        "RATE_LIMIT_MAX",
        "RATE_LIMIT_SIGNUP_MAX"
      ]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "NODE_OPTIONS",
        "DATABASE_URL",
        "REDIS_URL",
        "REDIS_PREFIX",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "APP_NAME",
        "EMAIL_FROM",
        "EMAIL_VERIFICATION",
        "TRUSTED_ORIGINS",
        "RESEND_API_KEY",
        "DEV_EMAIL_OVERRIDE",
        "HOST",
        "PORT",
        "RATE_LIMIT_MAX",
        "RATE_LIMIT_WINDOW",
        "OAUTH_TEST_PROVIDER"
      ]
    },
    "test:integration:all": {
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "NODE_OPTIONS",
        "DATABASE_URL",
        "REDIS_URL",
        "REDIS_PREFIX",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "APP_NAME",
        "EMAIL_FROM",
        "EMAIL_VERIFICATION",
        "TRUSTED_ORIGINS",
        "RESEND_API_KEY",
        "DEV_EMAIL_OVERRIDE",
        "HOST",
        "PORT",
        "RATE_LIMIT_MAX",
        "RATE_LIMIT_WINDOW",
        "OAUTH_TEST_PROVIDER"
      ]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_URL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD",
        "SEED_ADMIN_NAME",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    "db:migrate:dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    "db:migrate:deploy": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "auth:generate": {
      "cache": false
    }
  }
}
